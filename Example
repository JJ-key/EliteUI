-- ── BACKGROUND LOOPS ──────────────────────────────────────

RunService.Stepped:Connect(function()
    if noclipEnabled then
        local char = LocalPlayer.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    -- Anti-void
    local rp = getRootPart()
    if rp then
        if rp.Position.Y > -50 then
            lastSafePosition = rp.CFrame
        elseif antiVoidEnabled and lastSafePosition and not antiVoidDebounce then
            antiVoidDebounce = true
            rp.CFrame = lastSafePosition
            notify("Safety", "Saved from void!")
            task.wait(1)
            antiVoidDebounce = false
        end
    end

    -- Aimlock tracking
    if aimlockEnabled then
        if not aimlockTarget then aimlockTarget = getNearestPlayer() end
        if aimlockTarget and aimlockTarget.Character then
            local head = aimlockTarget.Character:FindFirstChild("Head")
            if head then
                local sf = (100 - aimlockSmoothness) / 100 + 0.05
                Camera.CFrame = Camera.CFrame:Lerp(
                    CFrame.new(Camera.CFrame.Position, head.Position), sf)
            end
        else
            aimlockTarget = nil
        end
    end

    -- Sprint: LeftShift on PC, auto-sprint when moving on mobile
    if sprintEnabled then
        local hum = getHumanoid()
        if hum then
            local base = movementEnabled and walkSpeed or 16
            local pressing = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                          or (UserInputService.TouchEnabled and hum.MoveDirection.Magnitude > 0.5)
            hum.WalkSpeed = pressing and base * sprintMultiplier or base
        end
    end
end)

