MovementTab:CreateSection("Fly System")
MovementTab:CreateParagraph({
    Title = "Controls",
    Content = "PC: WASD + Space (up) + LeftCtrl (down).\nMobile: joystick to move horizontally, Jump button to ascend."
})
MovementTab:CreateToggle({
    Name = "Fly", CurrentValue = false, Flag = "Fly",
    Callback = function(Value)
        flyEnabled = Value
        local rp  = getRootPart()
        local hum = getHumanoid()
        if not rp or not hum then return end

        if Value then
            local bodyG = Instance.new("BodyGyro")
            bodyG.Name = "FlyGyro"; bodyG.P = 9e4
            bodyG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyG.CFrame = rp.CFrame; bodyG.Parent = rp

            local bodyV = Instance.new("BodyVelocity")
            bodyV.Name = "FlyVelocity"
            bodyV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bodyV.Velocity = Vector3.new(0, 0, 0); bodyV.Parent = rp

            connections["fly"] = RunService.RenderStepped:Connect(function()
                if not flyEnabled then return end
                local r = getRootPart()
                local h = getHumanoid()
                if not r or not h then return end

                local bv = r:FindFirstChild("FlyVelocity")
                local bg = r:FindFirstChild("FlyGyro")
                if not bv or not bg then return end

                bg.CFrame = Camera.CFrame
                local dir = Vector3.new(0, 0, 0)

                -- PC keyboard: camera-look-relative movement
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector  end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector  end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end

                -- Mobile + PC: joystick / MoveDirection for horizontal movement
                local md = h.MoveDirection
                if md.Magnitude > 0.1 then
                    local flat = Vector3.new(md.X, 0, md.Z)
                    if flat.Magnitude > 0 then dir += flat.Unit end
                end

                -- Universal vertical (Space = up on both PC and mobile jump button)
                if UserInputService:IsKeyDown(Enum.KeyCode.Space)       then dir += Vector3.new(0,  1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,  1, 0) end

                bv.Velocity = dir.Magnitude > 0 and dir.Unit * flySpeed or Vector3.new(0, 0, 0)
            end)

            hum.PlatformStand = true
            notify("Movement", "Fly on! Joystick/WASD + Jump to ascend.")
        else
            if connections["fly"] then connections["fly"]:Disconnect(); connections["fly"] = nil end
            local r = getRootPart()
            if r then
                local bv = r:FindFirstChild("FlyVelocity"); if bv then bv:Destroy() end
                local bg = r:FindFirstChild("FlyGyro");     if bg then bg:Destroy() end
            end
            local h = getHumanoid()
            if h then h.PlatformStand = false end
            notify("Movement", "Fly off!")
        end
    end
})
MovementTab:CreateSlider({
    Name = "Fly Speed", Min = 10, Max = 500, CurrentValue = 50, Flag = "FlySpeed",
    Callback = function(Value) flySpeed = Value end
})

