TeleportTab:CreateSection("World Teleport")
-- Click-to-teleport works on both PC (mouse click) and mobile (tap)
TeleportTab:CreateToggle({
    Name = "Click / Tap to Teleport", CurrentValue = false, Flag = "ClickTP",
    Callback = function(Value)
        if Value then
            connections["clickTP"] = UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                local isTap = input.UserInputType == Enum.UserInputType.MouseButton1
                           or input.UserInputType == Enum.UserInputType.Touch
                if not isTap then return end
                local pos = input.Position
                local ray = Camera:ScreenPointToRay(pos.X, pos.Y)
                local hit = Workspace:Raycast(ray.Origin, ray.Direction * 500)
                if hit then
                    local rp = getRootPart()
                    if rp then
                        rp.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3, 0))
                        notify("Teleport", "Teleported!")
                    end
                end
            end)
            notify("Teleport", "Tap / click anywhere to teleport.")
        else
            if connections["clickTP"] then connections["clickTP"]:Disconnect(); connections["clickTP"] = nil end
            notify("Teleport", "Click-TP off!")
        end
    end
})

